<?xml version="1.0"?>
<robot name="qbotix_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- PROVISIONAL ROBOT DIMENSIONS: metres; measure the physical robot before Nav2 or motor actuation. -->
  <xacro:property name="chassis_length" value="0.64"/>
  <xacro:property name="chassis_width" value="0.40"/>
  <xacro:property name="chassis_height" value="0.11"/>
  <xacro:property name="plate_thickness" value="0.008"/>
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.02"/>
  <xacro:property name="wheel_x_offset" value="0.28"/>
  <xacro:property name="wheel_y_offset" value="0.20"/>

  <!-- GROUND REFERENCE -->
  <link name="base_footprint"/>

  <!-- MAIN ROBOT BODY -->
  <link name="base_link">

    <!-- Transparent acrylic top plate -->
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${plate_thickness}"/>
      </geometry>
      <material name="clear_acrylic">
        <color rgba="0.80 0.88 0.90 0.35"/>
      </material>
    </visual>

    <!-- Aluminium frame rails -->
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="${chassis_length} 0.018 0.018"/>
      </geometry>
      <material name="aluminium">
        <color rgba="0.65 0.67 0.68 1"/>
      </material>
    </visual>

    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.018 ${chassis_width} 0.018"/>
      </geometry>
      <material name="aluminium"/>
    </visual>

    <visual>
      <origin xyz="0 0.14 0"/>
      <geometry>
        <box size="${chassis_length} 0.012 0.018"/>
      </geometry>
      <material name="aluminium"/>
    </visual>

    <visual>
      <origin xyz="0 -0.14 0"/>
      <geometry>
        <box size="${chassis_length} 0.012 0.018"/>
      </geometry>
      <material name="aluminium"/>
    </visual>

    <!-- Chassis collision geometry -->
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} 0.018"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="8.0"/>
      <inertia
        ixx="0.1289" ixy="0" ixz="0"
        iyy="0.2833" iyz="0"
        izz="0.3563"/>
    </inertial>

  </link>

  <!-- Ground reference to chassis. Geometry is provisional until physically measured. -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + chassis_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- OMNI WHEEL MODEL -->
  <xacro:macro name="omni_wheel" params="name x y">

    <link name="${name}_link">

      <!-- Main wheel -->
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black">
          <color rgba="0.12 0.12 0.12 1"/>
        </material>
      </visual>

      <!-- Central hub -->
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="0.018" length="0.024"/>
        </geometry>
        <material name="wheel_hub">
          <color rgba="0.70 0.70 0.70 1"/>
        </material>
      </visual>

      <!-- Eight simplified roller visuals -->
      <xacro:property name="roller_radius" value="0.009"/>
      <xacro:property name="roller_length" value="0.024"/>
      <xacro:property name="roller_ring_radius" value="0.041"/>

      <xacro:property name="a0" value="0.0"/>
      <xacro:property name="a1" value="0.7853981634"/>
      <xacro:property name="a2" value="1.5707963268"/>
      <xacro:property name="a3" value="2.3561944902"/>
      <xacro:property name="a4" value="3.1415926536"/>
      <xacro:property name="a5" value="3.9269908170"/>
      <xacro:property name="a6" value="4.7123889804"/>
      <xacro:property name="a7" value="5.4977871438"/>

      <visual>
        <origin xyz="${roller_ring_radius*cos(a0)} 0 ${roller_ring_radius*sin(a0)}"
                rpy="0 ${-a0} 0"/>
        <geometry>
          <cylinder radius="${roller_radius}" length="${roller_length}"/>
        </geometry>
        <material name="roller_grey">
          <color rgba="0.72 0.72 0.72 1"/>
        </material>
      </visual>

      <visual>
        <origin xyz="${roller_ring_radius*cos(a1)} 0 ${roller_ring_radius*sin(a1)}"
                rpy="0 ${-a1} 0"/>
        <geometry>
          <cylinder radius="${roller_radius}" length="${roller_length}"/>
        </geometry>
        <material name="roller_grey"/>
      </visual>

      <visual>
        <origin xyz="${roller_ring_radius*cos(a2)} 0 ${roller_ring_radius*sin(a2)}"
                rpy="0 ${-a2} 0"/>
        <geometry>
          <cylinder radius="${roller_radius}" length="${roller_length}"/>
        </geometry>
        <material name="roller_grey"/>
      </visual>

      <visual>
        <origin xyz="${roller_ring_radius*cos(a3)} 0 ${roller_ring_radius*sin(a3)}"
                rpy="0 ${-a3} 0"/>
        <geometry>
          <cylinder radius="${roller_radius}" length="${roller_length}"/>
        </geometry>
        <material name="roller_grey"/>
      </visual>

      <visual>
        <origin xyz="${roller_ring_radius*cos(a4)} 0 ${roller_ring_radius*sin(a4)}"
                rpy="0 ${-a4} 0"/>
        <geometry>
          <cylinder radius="${roller_radius}" length="${roller_length}"/>
        </geometry>
        <material name="roller_grey"/>
      </visual>

      <visual>
        <origin xyz="${roller_ring_radius*cos(a5)} 0 ${roller_ring_radius*sin(a5)}"
                rpy="0 ${-a5} 0"/>
        <geometry>
          <cylinder radius="${roller_radius}" length="${roller_length}"/>
        </geometry>
        <material name="roller_grey"/>
      </visual>

      <visual>
        <origin xyz="${roller_ring_radius*cos(a6)} 0 ${roller_ring_radius*sin(a6)}"
                rpy="0 ${-a6} 0"/>
        <geometry>
          <cylinder radius="${roller_radius}" length="${roller_length}"/>
        </geometry>
        <material name="roller_grey"/>
      </visual>

      <visual>
        <origin xyz="${roller_ring_radius*cos(a7)} 0 ${roller_ring_radius*sin(a7)}"
                rpy="0 ${-a7} 0"/>
        <geometry>
          <cylinder radius="${roller_radius}" length="${roller_length}"/>
        </geometry>
        <material name="roller_grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.5"/>
        <inertia
          ixx="0.0004" ixy="0" ixz="0"
          iyy="0.000625" iyz="0"
          izz="0.0004"/>
      </inertial>

    </link>

    <!-- Wheel joint -->
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${-chassis_height/2}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <!-- Aluminium wheel mounting bracket -->
    <link name="${name}_bracket_link">
      <visual>
        <origin xyz="0 0 0"/>
        <geometry>
          <box size="0.045 0.018 0.075"/>
        </geometry>
        <material name="bracket_aluminium">
          <color rgba="0.65 0.67 0.68 1"/>
        </material>
      </visual>
    </link>

    <joint name="${name}_bracket_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_bracket_link"/>
      <origin xyz="${x*0.90} ${y*0.82} -0.005"/>
    </joint>

  </xacro:macro>

  <!-- Four omni wheels -->
  <xacro:omni_wheel name="front_left_wheel"
                    x="${wheel_x_offset}" y="${wheel_y_offset}"/>

  <xacro:omni_wheel name="front_right_wheel"
                    x="${wheel_x_offset}" y="${-wheel_y_offset}"/>

  <xacro:omni_wheel name="rear_left_wheel"
                    x="${-wheel_x_offset}" y="${wheel_y_offset}"/>

  <xacro:omni_wheel name="rear_right_wheel"
                    x="${-wheel_x_offset}" y="${-wheel_y_offset}"/>

  <!-- JETSON COMPUTER -->
  <link name="jetson_link">
    <visual>
      <geometry>
        <box size="0.22 0.14 0.035"/>
      </geometry>
      <material name="jetson_black">
        <color rgba="0.10 0.10 0.10 1"/>
      </material>
    </visual>
  </link>

  <joint name="jetson_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="jetson_link"/>
    <origin xyz="-0.10 0 0.080"/>
  </joint>

  <!-- CYTRON MOTOR DRIVER -->
  <link name="motor_driver_link">
    <visual>
      <geometry>
        <box size="0.10 0.07 0.025"/>
      </geometry>
      <material name="driver_black">
        <color rgba="0.06 0.06 0.06 1"/>
      </material>
    </visual>
  </link>

  <joint name="motor_driver_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="motor_driver_link"/>
    <origin xyz="0.10 0 0.075"/>
  </joint>

  <!-- BATTERY -->
  <link name="battery_link">
    <visual>
      <geometry>
        <box size="0.28 0.10 0.055"/>
      </geometry>
      <material name="battery_orange">
        <color rgba="0.95 0.35 0.05 1"/>
      </material>
    </visual>
  </link>

  <joint name="battery_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="battery_link"/>
    <origin xyz="0.12 0.12 0.085"/>
  </joint>

  <!-- Visual representation of the physical camera mount. This link is a
       child of base_link and coincides with zed_camera_link in the model. -->
  <link name="zed_camera_mount_link">
    <visual>
      <geometry>
        <box size="0.10 0.06 0.025"/>
      </geometry>
      <material name="camera_grey">
        <color rgba="0.30 0.30 0.30 1"/>
      </material>
    </visual>
  </link>

  <joint name="zed_camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed_camera_mount_link"/>
    <origin xyz="0 0 0.255" rpy="0 0 0"/>
  </joint>

  <link name="zed_camera_link"/>
  <joint name="zed_camera_link_joint" type="fixed">
    <parent link="zed_camera_mount_link"/>
    <child link="zed_camera_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
