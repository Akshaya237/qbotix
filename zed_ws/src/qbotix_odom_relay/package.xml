<?xml version="1.0"?>
<package format="3">
  <name>qbotix_odom_relay</name>
  <version>0.1.0</version>
  <description>Converts ZED camera odometry into base_link odometry and publishes odom to base_link TF.</description>
  <maintainer email="maintainer@example.com">QBotix project</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
